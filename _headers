# En-têtes de sécurité HTTP (Netlify)
# À appliquer en production ; voir documentation/configuration-cles-api.md
# https://docs.netlify.com/routing/headers/

/*
  # Protection contre le clickjacking
  X-Frame-Options: DENY
  # Empêcher le MIME sniffing
  X-Content-Type-Options: nosniff
  # HSTS : forcer HTTPS (à activer une fois HTTPS en place)
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  # Référent : ne pas envoyer l’URL complète aux sites tiers (sauf same-origin)
  Referrer-Policy: strict-origin-when-cross-origin
  # Permissions Policy : désactiver les APIs non utilisées
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  # Content-Security-Policy : restreindre les sources (scripts, styles, images, connect, frames)
  # Ajuster selon les domaines utilisés : Google Fonts, Calendly, EmailJS, BilletWeb, jsdelivr, unpkg, Mailchimp
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://assets.calendly.com https://unpkg.com https://s3.amazonaws.com 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://assets.calendly.com https://cdn-images.mailchimp.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.billetweb.fr https://api.emailjs.com https://calendly.com https://*.calendly.com; frame-src https://calendly.com https://*.calendly.com; form-action 'self' https://donnerdelavoix.us19.list-manage.com https://api.emailjs.com; base-uri 'self'
